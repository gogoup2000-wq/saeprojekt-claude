---
// 히어로 바로 아래 '약속' 띠 — 계약서에 적힌 약속만 흐르듯 보여 준다. 문구는 src/data/promises.ts
import { promises } from '../data/promises';
---

<div class="strip" role="region" aria-label="노브의 약속">
  <div class="track">
    <ul>
      {promises.map((p) => <li><span class="tick" aria-hidden="true"></span>{p}</li>)}
    </ul>
    <!-- 끊김 없이 이어지게 한 번 더 (읽기 프로그램에는 숨김) -->
    <ul aria-hidden="true">
      {promises.map((p) => <li><span class="tick"></span>{p}</li>)}
    </ul>
  </div>
</div>

<style>
  .strip {
    position: relative;
    border-block: 1px solid var(--line);
    background: rgba(12, 13, 16, 0.85);
    overflow: hidden;
    /* 양 끝이 흐려지며 사라짐 */
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
  }
  ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1.1rem 1.75rem;
    white-space: nowrap;
    font-size: 0.9375rem;
    color: var(--text-soft);
  }
  .tick {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 8px rgba(255, 138, 31, 0.7);
  }
  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: flow 48s linear infinite;
    }
    .strip:hover .track {
      animation-play-state: paused;
    }
  }
  @keyframes flow {
    to {
      transform: translateX(-50%);
    }
  }
  /* 모션 줄이기: 흐르지 않고 줄바꿈으로 전부 보여 줌 */
  @media (prefers-reduced-motion: reduce) {
    .strip {
      mask-image: none;
    }
    .track,
    ul:first-child {
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
    }
    ul[aria-hidden] {
      display: none;
    }
  }
</style>
