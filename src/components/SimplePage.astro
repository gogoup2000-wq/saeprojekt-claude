---
// 하위 페이지(개인정보처리방침·404) 공통 틀
import Base from '../layouts/Base.astro';
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<Base title={`${title} — 노브`} description={description}>
  <header class="bar">
    <div class="container row">
      <a href="/" class="logo">노브</a>
      <a href="/" class="home mono">← 메인으로</a>
    </div>
  </header>
  <main class="container page">
    <slot />
  </main>
</Base>

<style>
  .bar {
    border-bottom: 1px solid var(--line);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--header-h);
  }
  .logo {
    font-weight: var(--weight-strong);
    font-size: 1.25rem;
  }
  .home {
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .page {
    max-width: 820px;
    padding-block: 3rem 6rem;
  }
  .page :global(h1) {
    margin: 0 0 0.5rem;
    font-size: var(--fs-h2);
    letter-spacing: -0.02em;
  }
  .page :global(h2) {
    margin: 2.25rem 0 0.75rem;
    font-size: 1.125rem;
  }
  .page :global(p),
  .page :global(li) {
    color: #c9ccd1;
    line-height: 1.8;
  }
  .page :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }
  .page :global(th),
  .page :global(td) {
    padding: 0.6rem;
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .page :global(th) {
    background: var(--surface);
    font-weight: 600;
  }
</style>
