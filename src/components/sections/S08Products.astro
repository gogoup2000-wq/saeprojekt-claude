---
// 08 상품 — 상품 다이얼을 돌리면 그 플랜의 실제 화면(예시)과 구성이 바뀐다. 가격은 src/data/products.ts에서만.
import SectionHead from '../SectionHead.astro';
import PlanScreens from '../PlanScreens.astro';
import { products, buildLabel, won, commonBadge, vatNote } from '../../data/products';

const DETENT = 60; // 다이얼 한 칸 각도
const start = -((products.length - 1) / 2) * DETENT;
---

<section id="products" class="section products" aria-labelledby="products-title" data-products>
  <div class="container">
    <SectionHead
      id="products"
      label="08 / 상품"
      title="돌려서 고르세요. 받게 될 화면이 바로 보입니다"
      lead={`다섯 가지 구성 중 필요한 만큼만 켭니다. 제작비 한 번, 월 운영비는 오픈 다음 달부터. 가격은 모두 ${vatNote}입니다.`}
    />

    <div class="dial-panel">
      <div class="dial-col">
        <div class="dial-wrap">
          <svg class="dial-ticks" viewBox="0 0 220 220" aria-hidden="true">
            {products.map((_, i) => (
              <line x1="110" y1="8" x2="110" y2="22" transform={`rotate(${start + i * DETENT} 110 110)`} data-dtick />
            ))}
          </svg>
          <div class="dial" data-dial role="presentation">
            <div class="dial-rotor" data-dial-rotor><span></span></div>
          </div>
        </div>
        <div class="dial-choices" role="radiogroup" aria-label="상품 선택">
          {products.map((p, i) => (
            <button type="button" role="radio" class="choice" aria-checked={i === 0 ? 'true' : 'false'} data-choice={i}>
              <span class="c-name">{p.name.replace('노브 ', '')}</span>
              <span class="c-price mono">{buildLabel(p)}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="stage">
        <PlanScreens />

        <div class="readout" aria-live="polite">
          {products.map((p, i) => (
            <div class="spec" data-spec={i} hidden={i !== 0}>
              <div class="spec-head">
                <p class="spec-name">{p.name}</p>
                <p class="spec-line">{p.line}</p>
                <p class="spec-fit"><span class="label">이런 회사에</span>{p.fit}</p>
              </div>
              <div class="spec-body">
                <dl class="meters mono">
                  <div><dt>제작비</dt><dd>{buildLabel(p)}</dd></div>
                  <div><dt>월 운영비</dt><dd>{won(p.monthly)}</dd></div>
                  <div><dt>기간</dt><dd>{p.period}</dd></div>
                </dl>
                <ul class="inc">
                  {p.includes.map((x) => <li>{x}</li>)}
                  <li class="inc-badge">{commonBadge}</li>
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <p class="fine mono">{vatNote} · 월 운영비: 서버·도메인 유지, 장애 대응, 월 1회 소규모 수정 포함 · 기능 추가 별도 견적</p>
  </div>
</section>

<style define:vars={{ detent: `${DETENT}deg`, start: `${start}deg` }}>
  /* 다이얼 패널 */
  .dial-panel {
    display: grid;
    gap: 2rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--edge), rgba(21, 23, 27, 0.82);
    box-shadow: var(--shadow-card);
  }
  @media (min-width: 960px) {
    .dial-panel {
      grid-template-columns: 260px 1fr;
      gap: 2.5rem;
      align-items: start;
    }
    .dial-col {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
  .dial-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .dial-wrap {
    position: relative;
    width: 200px;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .dial-ticks {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .dial-ticks line {
    stroke: var(--line);
    stroke-width: 3;
    stroke-linecap: round;
    transition: stroke var(--dur-fast) var(--ease);
  }
  .dial-ticks line:global(.on) {
    stroke: var(--signal);
  }
  .dial {
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #0f1013;
    box-shadow: 0 0 0 1px var(--line), 0 16px 30px -10px rgba(0, 0, 0, 0.8);
    touch-action: none;
  }
  @media (pointer: fine) {
    .dial,
    .dial :global(*) {
      cursor: var(--cursor-scope);
    }
  }
  .dial-rotor {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.12), transparent 60%),
      conic-gradient(from 200deg, #3a3e45, #1c1e22, #34383e, #1a1c20, #3a3e45);
    box-shadow: inset 0 2px 1px rgba(255, 255, 255, 0.1), inset 0 -6px 12px rgba(0, 0, 0, 0.5);
    transform: rotate(var(--start));
  }
  .dial-rotor span {
    position: absolute;
    top: 9%;
    left: 50%;
    width: 4px;
    height: 18%;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--signal);
  }
  /* 플랜 목록 — 이름과 제작비를 한눈에 */
  .dial-choices {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
  }
  .choice {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(10, 11, 13, 0.5);
    color: var(--muted);
    text-align: left;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }
  .choice:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }
  .c-name {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .c-price {
    font-size: 0.8125rem;
  }
  .choice[aria-checked='true'] {
    color: var(--text);
    border-color: rgba(255, 138, 31, 0.6);
    background: linear-gradient(90deg, rgba(255, 138, 31, 0.12), rgba(255, 138, 31, 0.02));
  }
  .choice[aria-checked='true'] .c-price {
    color: var(--signal);
  }
  @media (max-width: 959.98px) {
    /* 모바일·태블릿: 목록을 2열로 */
    .dial-choices {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .choice {
      flex-direction: column;
      gap: 0.1rem;
    }
  }

  .stage {
    min-width: 0;
  }
  .readout {
    margin-top: 1.75rem;
  }
  .spec {
    display: grid;
    gap: 1.5rem;
  }
  /* display:grid가 hidden 속성을 덮지 않게 */
  .spec[hidden] {
    display: none;
  }
  @media (min-width: 1100px) {
    .spec {
      grid-template-columns: 1fr 1.1fr;
      gap: 2.5rem;
    }
  }
  .spec-fit {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
    padding: 0.9rem 1rem;
    border-left: 2px solid var(--signal);
    background: rgba(255, 138, 31, 0.05);
    color: var(--text-soft);
    font-size: 0.9375rem;
    line-height: 1.65;
  }
  .spec-name {
    margin: 0;
    font-size: 1.5rem;
    font-weight: var(--weight-strong);
  }
  .spec-line {
    margin: 0.3rem 0 1rem;
    color: var(--muted);
  }
  .meters {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0 0 1.25rem;
  }
  .meters div {
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #0e1013;
  }
  .meters dt {
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .meters dd {
    margin: 0.25rem 0 0;
    font-size: clamp(1rem, 0.85rem + 0.5vw, 1.25rem);
    font-weight: 700;
    color: var(--signal);
    white-space: nowrap;
  }
  .inc {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }
  .inc li::before {
    content: '— ';
    color: var(--muted);
  }
  .inc .inc-badge {
    color: var(--ok);
  }
  .fine {
    margin: 1rem 0 0;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  @media (max-width: 767.98px) {
    .meters {
      grid-template-columns: 1fr 1fr;
    }
    .meters div:last-child {
      grid-column: 1 / 3;
    }
  }
</style>

<script>
  import { gsap } from '../../scripts/smooth';
  import { Draggable } from 'gsap/Draggable';
  import { canAnimate, EASE } from '../../scripts/motion';
  import { products } from '../../data/products';

  gsap.registerPlugin(Draggable);

  const root = document.querySelector<HTMLElement>('[data-products]')!;
  const rotor = root.querySelector<HTMLElement>('[data-dial-rotor]')!;
  const dial = root.querySelector<HTMLElement>('[data-dial]')!;
  const ticks = Array.from(root.querySelectorAll<SVGLineElement>('[data-dtick]'));
  const choices = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-choice]'));
  const specs = Array.from(root.querySelectorAll<HTMLElement>('[data-spec]'));

  const N = products.length;
  const DETENT = 60;
  const START = -((N - 1) / 2) * DETENT;
  const angles = Array.from({ length: N }, (_, i) => START + i * DETENT);
  let current = -1;
  let showScreen: (i: number) => void = () => {};

  function select(i: number, spin = true): void {
    if (i === current) return;
    current = i;
    ticks.forEach((t, j) => t.classList.toggle('on', j === i));
    choices.forEach((c, j) => c.setAttribute('aria-checked', String(j === i)));
    specs.forEach((s, j) => (s.hidden = j !== i));
    showScreen(i);
    if (spin) gsap.to(rotor, { rotation: angles[i], duration: canAnimate() ? 0.35 : 0, ease: EASE });
    if (canAnimate()) {
      gsap.fromTo(specs[i].querySelectorAll('dd'), { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.25, stagger: 0.05, ease: EASE });
    }
  }

  gsap.set(rotor, { rotation: angles[0] });
  select(0, false);

  // 드래그 후 가장 가까운 칸에서 '딸깍' 멈춤
  Draggable.create(rotor, {
    type: 'rotation',
    trigger: dial,
    bounds: { minRotation: angles[0], maxRotation: angles[N - 1] },
    onDrag() {
      const i = Math.round((this.rotation - START) / DETENT);
      if (i !== current) select(Math.max(0, Math.min(N - 1, i)), false);
    },
    onRelease() {
      gsap.to(rotor, { rotation: angles[current], duration: 0.2, ease: EASE });
    },
  });

  choices.forEach((c, i) => c.addEventListener('click', () => select(i)));
  root.querySelector('.dial-choices')!.addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key;
    const fwd = k === 'ArrowRight' || k === 'ArrowDown';
    if (!fwd && k !== 'ArrowLeft' && k !== 'ArrowUp') return;
    e.preventDefault();
    const n = (current + (fwd ? 1 : -1) + N) % N;
    select(n);
    choices[n].focus();
  });

  // 플랜별 화면: 선택된 것만 보이고, 880px 캔버스를 폭에 맞춰 축소
  const screens = Array.from(root.querySelectorAll<HTMLElement>('[data-screen]'));
  const MIN_SCALE = 0.5; // 이보다 작으면 글자가 안 읽혀서 옆으로 밀어 보게 함
  const wrap = root.querySelector<HTMLElement>('[data-screens]')!;
  const fit = () => {
    let pan = false;
    root.querySelectorAll<HTMLElement>('[data-viewport]').forEach((v) => {
      if (!v.clientWidth) return;
      const raw = v.clientWidth / 880;
      v.style.setProperty('--s', String(Math.min(1, Math.max(MIN_SCALE, raw))));
      v.classList.toggle('pan', raw < MIN_SCALE);
      pan ||= raw < MIN_SCALE;
    });
    wrap.classList.toggle('can-pan', pan);
  };
  new ResizeObserver(fit).observe(wrap);
  showScreen = (i) => {
    screens.forEach((s, j) => (s.hidden = j !== i));
    fit();
  };
  showScreen(current);
</script>
