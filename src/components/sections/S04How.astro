---
// 04 작동 원리 — 광고부터 광고 성과 전송까지 데이터가 흐르는 연결도
import SectionHead from '../SectionHead.astro';
import { pipeline } from '../../data/pipeline';
---

<section id="how" class="section how" aria-labelledby="how-title" data-how>
  <div class="container">
    <SectionHead
      id="how"
      label="04 / 작동 원리"
      title="화면이 아니라 흐름을 설계합니다"
      lead="문의 한 건이 광고에서 들어와 담당자 휴대폰을 거쳐 다시 광고로 돌아가기까지. 노드에 마우스를 올리면 각 단계에서 하는 일이 보입니다."
    />

    <div class="flow" data-flow>
      <div class="rail" aria-hidden="true">
        <span class="rail-fill" data-rail></span>
        <span class="packet" style="--d:0s"></span>
        <span class="packet" style="--d:1s"></span>
        <span class="packet" style="--d:2s"></span>
      </div>
      <ol class="nodes">
        {pipeline.map((n, i) => (
          <li class="node" tabindex="0" aria-describedby={`how-tip-${i}`}>
            <span class="dot mono">{String(i + 1).padStart(2, '0')}</span>
            <strong>{n.step}</strong>
            <span class="tech mono">{n.tech}</span>
            <span class="tip" role="tooltip" id={`how-tip-${i}`}>{n.does}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .flow {
    position: relative;
  }
  .nodes {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .node {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0 0.25rem 0.5rem;
    text-align: center;
    border-radius: 8px;
    outline-offset: 6px;
  }
  @media (pointer: fine) {
    .node {
      cursor: var(--cursor-scope);
    }
  }
  .dot {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 0.5rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    font-size: var(--fs-label);
    color: var(--muted);
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }
  .node:hover .dot,
  .node:focus-visible .dot {
    border-color: var(--signal);
    color: var(--signal);
    box-shadow: 0 0 0 5px rgba(255, 138, 31, 0.12);
  }
  .node strong {
    font-size: 1rem;
  }
  .tech {
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .tip {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    z-index: 2;
    width: 220px;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #0f1114;
    color: var(--text);
    font-size: var(--fs-small);
    line-height: 1.5;
    text-align: left;
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -4px);
    transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), visibility 0s linear var(--dur-fast);
  }
  .node:hover .tip,
  .node:focus-visible .tip {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition-delay: 0s;
  }
  .node:first-child .tip {
    left: 0;
    transform: none;
  }
  .node:last-child .tip {
    left: auto;
    right: 0;
    transform: none;
  }

  /* 연결선: 첫 노드 중심 ~ 마지막 노드 중심 */
  .rail {
    position: absolute;
    top: 28px;
    left: calc(100% / 12);
    right: calc(100% / 12);
    height: 2px;
    background: var(--line);
  }
  .rail-fill {
    position: absolute;
    inset: 0;
    background: var(--signal);
    transform-origin: left;
    transform: scaleX(1);
  }
  :global(.motion-ok) .rail-fill {
    transform: scaleX(0);
  }
  .packet {
    position: absolute;
    top: -3px;
    left: 0;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 10px 2px rgba(255, 138, 31, 0.6);
    opacity: 0;
  }
  .flow:global(.is-flowing) .packet {
    animation: travel-x 3s linear var(--d) infinite;
  }
  @keyframes travel-x {
    0% { left: 0; opacity: 0; }
    8% { opacity: 1; }
    92% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }

  /* 모바일: 세로 연결도 */
  @media (max-width: 767.98px) {
    .nodes {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .node {
      display: grid;
      grid-template-columns: 56px 1fr;
      grid-template-rows: auto auto;
      column-gap: 1rem;
      row-gap: 0.1rem;
      align-items: center;
      text-align: left;
      padding: 0;
    }
    .dot {
      grid-row: 1 / 3;
      margin: 0;
    }
    .node strong {
      align-self: end;
    }
    .tech {
      align-self: start;
    }
    .tip {
      position: static;
      grid-column: 2;
      width: auto;
      margin-top: 0.4rem;
      padding: 0;
      border: 0;
      background: none;
      box-shadow: none;
      color: var(--muted);
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .node:first-child .tip,
    .node:last-child .tip {
      transform: none;
    }
    .rail {
      top: 28px;
      bottom: 28px;
      left: 27px;
      right: auto;
      width: 2px;
      height: auto;
    }
    .rail-fill {
      transform-origin: top;
    }
    :global(.motion-ok) .rail-fill {
      transform: scaleY(0);
    }
    .packet {
      left: -3px;
      top: 0;
      margin: -4px 0 0;
    }
    .flow:global(.is-flowing) .packet {
      animation-name: travel-y;
    }
    @keyframes travel-y {
      0% { top: 0; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { top: 100%; opacity: 0; }
    }
  }
</style>

<script>
  import { gsap } from '../../scripts/smooth';
  import { canAnimate, isMobile } from '../../scripts/motion';

  const flow = document.querySelector<HTMLElement>('[data-flow]')!;
  const rail = document.querySelector<HTMLElement>('[data-rail]')!;

  if (canAnimate()) {
    const axis = isMobile() ? 'scaleY' : 'scaleX';
    gsap.fromTo(
      rail,
      { [axis]: 0 },
      {
        [axis]: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: flow,
          start: 'top 80%',
          end: isMobile() ? 'bottom 60%' : 'top 35%',
          scrub: 0.5,
          onLeave: () => flow.classList.add('is-flowing'),
          onEnterBack: () => flow.classList.remove('is-flowing'),
        },
      },
    );
  }
</script>
