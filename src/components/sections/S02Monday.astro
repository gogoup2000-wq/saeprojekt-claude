---
// 02 월요일 오전 9시 — 화면을 고정한 채 스크롤하면 하루 운영이 장면별로 바뀐다.
const kinds = [
  { key: 'fund', label: '정책자금' },
  { key: 'ins', label: '보험' },
  { key: 'edu', label: '교육' },
];
const names = ['김', '이', '박', '최', '정', '강', '조', '윤', '장', '임', '한', '오', '서', '신', '권', '황', '안'];
const leads = names.map((n, i) => ({ name: `${n}OO`, kind: kinds[(i * 7 + 2) % 3] }));
const agents = ['김선임', '이주임', '박대리'];
const perAgent = agents.map((_, a) => leads.filter((_, i) => i % 3 === a).length);

const scenes = [
  { time: '09:00', title: '문의 17건이 쌓였습니다', desc: '주말 동안 광고로 들어온 문의. 예전엔 여기서부터 엑셀에 옮겨 적었습니다.' },
  { time: '09:01', title: '자동 분류', desc: '문의 내용을 읽고 업종별로 태그를 붙입니다(자동 분류·태깅).' },
  { time: '09:02', title: '담당자 배정', desc: '담당자 3명에게 순서대로 나눕니다(문의 자동 배정·라운드로빈).' },
  { time: '09:03', title: '고객 자동 문자', desc: '고객에게 접수 안내와 담당자 이름이 바로 나갑니다(자동 발송).' },
  { time: '18:00', title: '정산 집계', desc: '상태값 기준으로 담당자별 처리 건수가 자동 합산됩니다(정산 자동 집계).' },
];
const sms = [
  '[노브상담] 김OO님, 문의가 접수되었습니다. 담당 김선임이 오늘 중 연락드립니다.',
  '[노브상담] 이OO님, 문의가 접수되었습니다. 담당 이주임이 오늘 중 연락드립니다.',
  '[노브상담] 박OO님, 문의가 접수되었습니다. 담당 박대리가 오늘 중 연락드립니다.',
];
---

<section id="monday" class="monday" aria-labelledby="monday-title" data-monday>
  <div class="container head">
    <p class="label reveal">02 / 하루 운영</p>
    <h2 id="monday-title" class="reveal">월요일 오전 9시</h2>
    <p class="lead reveal">같은 월요일, 사람이 손대는 곳만 달라집니다. 스크롤하면 하루가 흘러갑니다.</p>
  </div>

  <!-- 데스크톱: 고정 무대 (JS가 is-live를 붙일 때만 보임) -->
  <div class="pin" data-monday-pin>
    <div class="container pin-inner">
      <div class="stage-col">
        <div class="clock mono" data-clock aria-hidden="true">09:00</div>
        <div class="stage" data-stage aria-hidden="true">
          {agents.map((a, i) => (
            <div class="agent mono" data-agent style={`--a:${i}`}>{a}</div>
          ))}
          {leads.map((l) => (
            <div class="card" data-card data-kind={l.kind.key}>
              <span class="card-name">{l.name}</span>
              <span class={`card-tag mono k-${l.kind.key}`}>{l.kind.label}</span>
            </div>
          ))}
          <div class="phone" data-phone>
            <div class="phone-notch"></div>
            <p class="phone-head mono">문자 메시지</p>
            {sms.map((m) => <p class="sms" data-sms>{m}</p>)}
          </div>
          <div class="settle" data-settle>
            <p class="settle-head mono">9월 29일 정산 집계 <span class="tag-example">예시</span></p>
            <table>
              <thead><tr><th>담당자</th><th>배정</th><th>상담 완료</th></tr></thead>
              <tbody>
                {agents.map((a, i) => (
                  <tr><td>{a}</td><td class="mono" data-count={perAgent[i]}>0</td><td class="mono" data-count={perAgent[i] - 1}>0</td></tr>
                ))}
              </tbody>
              <tfoot>
                <tr><td>합계</td><td class="mono" data-count={leads.length}>0</td><td class="mono" data-count={leads.length - 3}>0</td></tr>
              </tfoot>
            </table>
          </div>
        </div>
        <p class="stage-note mono">숫자는 모두 <span class="tag-example">예시</span></p>
      </div>
      <ol class="captions" data-captions>
        {scenes.map((s, i) => (
          <li class="caption" data-caption style={`--i:${i}`}>
            <span class="mono cap-time">{s.time}</span>
            <strong>{s.title}</strong>
            <p>{s.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <!-- 모바일·모션 줄이기: 세로 카드 -->
  <ol class="container static-list" data-monday-static>
    {scenes.map((s, i) => (
      <li class="scard reveal">
        <span class="mono scard-time">{s.time}</span>
        <div>
          <strong>{s.title}</strong>
          <p>{s.desc}</p>
          {i === 0 && <p class="scard-fig mono">신규 문의 17건 <span class="tag-example">예시</span></p>}
          {i === 2 && <p class="scard-fig mono">김선임 {perAgent[0]} · 이주임 {perAgent[1]} · 박대리 {perAgent[2]} <span class="tag-example">예시</span></p>}
          {i === 3 && <p class="scard-sms">{sms[0]}</p>}
          {i === 4 && <p class="scard-fig mono">합계 {leads.length}건 · 상담 완료 {leads.length - 3}건 <span class="tag-example">예시</span></p>}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .monday {
    padding-top: var(--section-y);
    border-top: 1px solid var(--line);
  }
  .head h2 {
    margin: 0.5rem 0 0.75rem;
    font-size: var(--fs-h2);
    font-weight: var(--weight-strong);
    letter-spacing: -0.02em;
  }
  .lead {
    margin: 0 0 3rem;
    color: var(--muted);
    max-width: 36rem;
  }

  /* 기본: 정적 목록 표시, 무대 숨김 */
  .pin {
    display: none;
  }
  .monday:global(.is-live) .pin {
    display: block;
  }
  .monday:global(.is-live) .static-list {
    display: none;
  }

  .pin {
    height: 100vh;
    padding-top: calc(var(--header-h) + 1.5rem);
  }
  .pin-inner {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    height: calc(100% - 2rem);
  }
  .stage-col {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .clock {
    font-size: clamp(3rem, 2rem + 3vw, 5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    margin-bottom: 1rem;
  }
  .stage {
    position: relative;
    flex: 1;
    min-height: 0;
    max-height: 560px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(21, 23, 27, 0.7);
    overflow: hidden;
  }
  .stage-note {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: var(--fs-label);
  }
  .agent {
    position: absolute;
    top: 16px;
    left: 0;
    font-size: var(--fs-label);
    color: var(--muted);
    opacity: 0;
  }
  .card {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--cw, 132px);
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    padding: 0 0.6rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #111316;
    font-size: 0.8125rem;
    will-change: transform;
  }
  .card-tag {
    font-size: 0.625rem;
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid currentColor;
    color: var(--muted);
    opacity: 0.25;
  }
  .card-tag.k-fund { --k: var(--signal); }
  .card-tag.k-ins { --k: var(--ok); }
  .card-tag.k-edu { --k: var(--text); }
  .stage:global(.tagged) .card-tag {
    color: var(--k);
    opacity: 1;
  }

  .phone {
    position: absolute;
    top: 50%;
    right: 24px;
    width: 230px;
    padding: 1.25rem 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: #0c0d10;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
    opacity: 0;
    transform: translate(40px, -50%);
  }
  .phone-notch {
    width: 60px;
    height: 6px;
    margin: 0 auto 0.8rem;
    border-radius: 3px;
    background: var(--line);
  }
  .phone-head {
    margin: 0 0 0.6rem;
    font-size: 0.6875rem;
    color: var(--muted);
    text-align: center;
  }
  .sms {
    margin: 0 0 0.5rem;
    padding: 0.5rem 0.65rem;
    border-radius: 12px 12px 12px 3px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 0.6875rem;
    line-height: 1.45;
    opacity: 0;
  }

  .settle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(420px, 86%);
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #0f1114;
    opacity: 0;
    transform: translate(-50%, -46%);
  }
  .settle-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 0 0.75rem;
    font-size: var(--fs-label);
    color: var(--muted);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  th,
  td {
    padding: 0.45rem 0.25rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }
  th {
    font-weight: 400;
    color: var(--muted);
    font-size: var(--fs-label);
  }
  td.mono {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  th:not(:first-child) {
    text-align: right;
  }
  tfoot td {
    border-bottom: 0;
    font-weight: 700;
  }
  tfoot td.mono {
    color: var(--signal);
    font-size: 1.125rem;
  }

  .captions {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    align-self: center;
    min-height: 220px;
  }
  .caption {
    position: absolute;
    inset: 0 0 auto 0;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity var(--dur-scene) var(--ease), transform var(--dur-scene) var(--ease);
  }
  .caption:global(.is-on) {
    opacity: 1;
    transform: none;
  }
  .cap-time {
    color: var(--signal);
    font-size: var(--fs-label);
  }
  .caption strong {
    display: block;
    margin: 0.4rem 0 0.6rem;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .caption p {
    margin: 0;
    color: var(--muted);
  }

  /* 정적 목록 */
  .static-list {
    display: grid;
    gap: 1rem;
    margin: 0 auto;
    padding-bottom: var(--section-y);
    list-style: none;
  }
  .scard {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(21, 23, 27, 0.7);
  }
  .scard-time {
    color: var(--signal);
    font-size: 1.125rem;
    font-weight: 700;
  }
  .scard strong {
    font-size: 1.125rem;
  }
  .scard p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .scard .scard-fig {
    margin-top: 0.75rem;
    color: var(--text);
    font-size: var(--fs-small);
  }
  .scard-sms {
    margin-top: 0.75rem !important;
    padding: 0.6rem 0.8rem;
    border-radius: 12px 12px 12px 3px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: var(--fs-small) !important;
  }
</style>

<script>
  import { initMonday } from '../../scripts/monday';
  initMonday();
</script>
