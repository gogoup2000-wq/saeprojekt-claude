---
// 06 실가동 지표 — src/data/proof.ts 실측값만. 값이 없는 계기판은 표시하지 않는다.
import SectionHead from '../SectionHead.astro';
import { gauges, screens } from '../../data/proof';

const shown = gauges.filter((g) => g.value !== null && Number.isFinite(g.value));
const visible = shown.length > 0 || screens.length > 0;
// 반원 계기판: 바늘 각도 -90°(0) ~ 90°(max)
const angle = (v: number, max: number) => -90 + Math.min(1, v / max) * 180;
---

{
  visible && (
    <section id="proof" class="section proof" aria-labelledby="proof-title" data-proof>
      <div class="container">
        <SectionHead
          id="proof"
          label="06 / 실가동 지표"
          title="샘플이 아닙니다. 지금도 돌아갑니다"
          lead="우리 회사에서 매일 쓰는 시스템의 실측값입니다. 고객 정보는 모두 가렸습니다."
        />

        {shown.length > 0 && (
          <div class="gauges">
            {shown.map((g) => (
              <figure class="gauge">
                <svg viewBox="0 0 200 116" aria-hidden="true">
                  <path class="g-track" d="M16 104 A84 84 0 0 1 184 104" pathLength="100" />
                  <path class="g-fill" d="M16 104 A84 84 0 0 1 184 104" pathLength="100" data-g-fill={Math.min(100, ((g.value as number) / g.max) * 100)} />
                  <g class="needle" data-needle={angle(g.value as number, g.max)}>
                    <line x1="100" y1="104" x2="100" y2="34" />
                    <circle cx="100" cy="104" r="6" />
                  </g>
                </svg>
                <figcaption>
                  <strong class="mono">
                    <span data-g-value={g.value} data-digits={g.digits ?? 0}>
                      {(g.value as number).toLocaleString('ko-KR', { maximumFractionDigits: g.digits ?? 0 })}
                    </span>
                    <small>{g.unit}</small>
                  </strong>
                  <span class="g-label">{g.label}</span>
                  {g.note && <span class="g-note mono">{g.note}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        )}

        {screens.length > 0 && (
          <ul class="screens">
            {screens.map((s) => (
              <li>
                <button type="button" class="shot" data-zoom={s.src} data-alt={s.alt}>
                  <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
                  <span class="mono">{s.caption}</span>
                </button>
              </li>
            ))}
          </ul>
        )}
      </div>

      <dialog class="lightbox" data-lightbox>
        <form method="dialog">
          <button class="close mono" aria-label="닫기">닫기 ✕</button>
        </form>
        <img alt="" data-lightbox-img />
      </dialog>
    </section>
  )
}

<style>
  .gauges {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .gauge {
    margin: 0;
    padding: 1.5rem 1.25rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(21, 23, 27, 0.75);
    text-align: center;
  }
  .gauge svg {
    width: 100%;
    max-width: 220px;
    margin: 0 auto;
    overflow: visible;
  }
  .g-track,
  .g-fill {
    fill: none;
    stroke-width: 10;
    stroke-linecap: round;
  }
  .g-track {
    stroke: var(--line);
  }
  .g-fill {
    stroke: var(--signal);
  }
  .needle line {
    stroke: var(--text);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .needle circle {
    fill: var(--text);
  }
  .needle {
    transform-origin: 100px 104px;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.75rem;
  }
  figcaption strong {
    font-size: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  figcaption small {
    margin-left: 0.2rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .g-label {
    font-weight: 600;
  }
  .g-note {
    font-size: var(--fs-label);
    color: var(--muted);
  }

  .screens {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .shot {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    text-align: left;
    cursor: zoom-in;
  }
  .shot img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform var(--dur-scene) var(--ease);
  }
  .shot:hover img {
    transform: scale(1.03);
  }
  .shot span {
    display: block;
    padding: 0.6rem 0.8rem;
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .lightbox {
    max-width: min(1200px, 94vw);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.8);
  }
  .lightbox img {
    width: 100%;
  }
  .close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    font-size: var(--fs-label);
  }
</style>

<script>
  import { gsap } from '../../scripts/smooth';
  import { canAnimate, onceVisible, EASE, fmt } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-proof]');
  if (root) {
    // 계기판: 화면에 들어오면 바늘과 숫자가 함께 올라감
    root.querySelectorAll<HTMLElement>('.gauge').forEach((g) => {
      const fill = g.querySelector<SVGPathElement>('[data-g-fill]')!;
      const needle = g.querySelector<SVGGElement>('[data-needle]')!;
      const num = g.querySelector<HTMLElement>('[data-g-value]')!;
      const pct = Number(fill.dataset.gFill);
      const deg = Number(needle.dataset.needle);
      const end = Number(num.dataset.gValue);
      const digits = Number(num.dataset.digits);
      if (!canAnimate()) {
        fill.style.strokeDasharray = `${pct} 100`;
        needle.style.transform = `rotate(${deg}deg)`;
        return;
      }
      fill.style.strokeDasharray = '0 100';
      needle.style.transform = 'rotate(-90deg)';
      num.textContent = fmt(0, digits);
      onceVisible(g, () => {
        const o = { p: 0 };
        gsap.to(o, {
          p: 1,
          duration: 1.4,
          ease: EASE,
          onUpdate: () => {
            fill.style.strokeDasharray = `${pct * o.p} 100`;
            needle.style.transform = `rotate(${-90 + (deg + 90) * o.p}deg)`;
            num.textContent = fmt(end * o.p, digits);
          },
        });
      });
    });

    // 실제 화면 확대
    const box = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = root.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        img.src = b.dataset.zoom!;
        img.alt = b.dataset.alt || '';
        box.showModal();
      }),
    );
    box.addEventListener('click', (e) => e.target === box && box.close());
  }
</script>
