---
// 12 무료 자동화 진단 — 한 화면에 한 문항, 노브 모양 진행 게이지, 제출하면 진단 리포트
import SectionHead from '../SectionHead.astro';
import { questions } from '../../data/diagnosis-rules';
---

<section id="diagnosis" class="section diag" aria-labelledby="diagnosis-title" data-diag>
  <div class="container">
    <SectionHead
      id="diagnosis"
      label="12 / 무료 자동화 진단"
      title="10문항이면 우리 회사에 맞는 구성이 나옵니다"
      lead="선택만 하면 됩니다. 약 1분. 끝나면 추천 구성과 견적 범위를 리포트로 바로 보여드립니다."
    />

    <div class="box">
      <div class="top">
        <div class="gauge" aria-hidden="true">
          <svg viewBox="0 0 64 64">
            <circle class="g-bg" cx="32" cy="32" r="26" pathLength="100" />
            <circle class="g-fg" cx="32" cy="32" r="26" pathLength="100" data-gauge />
            <line class="g-needle" x1="32" y1="32" x2="32" y2="12" data-needle />
          </svg>
        </div>
        <p class="step mono" data-step aria-live="polite">01 / 10</p>
        <button type="button" class="back mono" data-back hidden>← 이전</button>
      </div>

      <!-- 문항 -->
      {questions.map((q, i) => (
        <fieldset class="screen" data-q={q.id} data-multi={q.multi ? '1' : ''} hidden={i !== 0}>
          <legend class="q">{q.q}</legend>
          <div class="opts">
            {q.options.map((o) => (
              <button type="button" class="opt" data-v={o.v} aria-pressed="false">{o.label}</button>
            ))}
          </div>
          {q.multi && (
            <button type="button" class="next" data-next disabled>다음</button>
          )}
        </fieldset>
      ))}

      <!-- 연락처 -->
      <form class="screen contact" data-contact hidden novalidate>
        <p class="q">마지막입니다. 리포트를 받을 연락처를 남겨주세요.</p>
        <p class="calc-note mono" data-calc-note hidden></p>
        <div class="fields">
          <label><span>이름</span><input name="name" type="text" required maxlength="20" autocomplete="name" /></label>
          <label><span>연락처</span><input name="phone" type="tel" required inputmode="tel" maxlength="16" placeholder="010-0000-0000" autocomplete="tel" /></label>
          <label><span>회사명</span><input name="company" type="text" required maxlength="40" autocomplete="organization" /></label>
          <!-- 봇 방지: 사람에게는 보이지 않는 칸 -->
          <label class="hp" aria-hidden="true"><span>웹사이트</span><input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>
        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>
            <b>[필수] 개인정보 수집·이용에 동의합니다.</b>
            수집 항목: 이름, 연락처, 회사명, 진단 응답 · 목적: 진단 결과 안내와 상담 연락 · 보유 기간: 수집일로부터 1년 (동의 거부 시 진단 결과를 받을 수 없습니다) · <a href="/privacy" target="_blank" rel="noopener">개인정보처리방침</a>
          </span>
        </label>
        <p class="err" role="alert" data-err></p>
        <button type="submit" class="submit" data-submit>진단 결과 보기</button>
      </form>

      <!-- 리포트 -->
      <article class="screen report" data-report hidden tabindex="-1" aria-labelledby="report-title">
        <header class="r-head">
          <p class="mono r-no" data-r-no></p>
          <h3 id="report-title">자동화 진단 리포트</h3>
          <p class="r-company" data-r-company></p>
        </header>
        <div class="r-grid">
          <section>
            <h4 class="mono">01 현재 상태</h4>
            <ul class="r-list" data-r-summary></ul>
          </section>
          <section>
            <h4 class="mono">02 진단</h4>
            <ul class="r-list reasons" data-r-reasons></ul>
          </section>
          <section class="r-rec">
            <h4 class="mono">03 추천 구성</h4>
            <p class="r-product" data-r-product></p>
            <p class="r-next" data-r-next hidden></p>
            <ul class="r-inc" data-r-inc></ul>
          </section>
          <section>
            <h4 class="mono">04 견적 범위 · 기간</h4>
            <dl class="r-meters mono">
              <div><dt>제작비</dt><dd data-r-cost></dd></div>
              <div><dt>월 운영비</dt><dd data-r-monthly></dd></div>
              <div><dt>예상 기간</dt><dd data-r-period></dd></div>
            </dl>
            <p class="r-calc" data-r-calc hidden></p>
            <p class="r-fine">VAT 별도 · 최종 견적은 요구사항 정의 후 확정</p>
          </section>
        </div>
        <section class="r-nextstep">
          <h4 class="mono">05 다음 단계</h4>
          <ol>
            <li>1영업일 안에 담당자가 남겨주신 번호로 연락드립니다.</li>
            <li>20분 통화로 현재 문의 흐름을 확인하고, 포함·불포함 범위를 정리합니다.</li>
            <li>작업 범위표와 일정표를 문서로 보내드립니다. 결정은 그 뒤에 하셔도 됩니다.</li>
          </ol>
        </section>
      </article>
    </div>
  </div>
</section>

<style>
  .box {
    max-width: 820px;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(21, 23, 27, 0.8);
  }
  .top {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.75rem;
  }
  .gauge svg {
    width: 52px;
    height: 52px;
    transform: rotate(-90deg);
  }
  .g-bg,
  .g-fg {
    fill: none;
    stroke-width: 5;
  }
  .g-bg {
    stroke: var(--line);
  }
  .g-fg {
    stroke: var(--signal);
    stroke-linecap: round;
    stroke-dasharray: 0 100;
    transition: stroke-dasharray var(--dur-scene) var(--ease);
  }
  .g-needle {
    stroke: var(--text);
    stroke-width: 2.5;
    stroke-linecap: round;
    transform-origin: 32px 32px;
    transform: rotate(90deg);
    transition: transform var(--dur-scene) var(--ease);
  }
  .step {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .back {
    margin-left: auto;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--muted);
    font-size: var(--fs-label);
  }
  .screen {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .screen:not([hidden]) {
    animation: in var(--dur-scene) var(--ease);
  }
  @keyframes in {
    from { opacity: 0; transform: translateX(16px); }
  }
  .q {
    display: block;
    margin: 0 0 1.25rem;
    padding: 0;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .opts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.5rem;
  }
  .opt {
    padding: 0.95rem 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    text-align: left;
    font-size: 0.9375rem;
    transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .opt:hover {
    border-color: #3a3f47;
  }
  .opt[aria-pressed='true'] {
    border-color: var(--signal);
    background: rgba(255, 138, 31, 0.1);
    color: var(--signal);
  }
  .next,
  .submit {
    margin-top: 1.25rem;
    padding: 0.85rem 1.6rem;
    border: 0;
    border-radius: 999px;
    background: var(--signal);
    color: #111;
    font-weight: 700;
  }
  .next:disabled,
  .submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .fields {
    display: grid;
    gap: 0.8rem;
  }
  @media (min-width: 700px) {
    .fields {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .fields label {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .fields input {
    width: 100%;
    padding: 0.8rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }
  .fields input:focus {
    outline: none;
    border-color: var(--signal);
  }
  .fields input[aria-invalid='true'] {
    border-color: #ff5a5a;
  }
  .hp {
    position: absolute !important;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .consent {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    margin-top: 1.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: var(--fs-label);
    line-height: 1.6;
    color: var(--muted);
  }
  .consent b {
    display: block;
    color: var(--text);
    font-size: var(--fs-small);
  }
  .consent input {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    flex-shrink: 0;
    accent-color: var(--signal);
  }
  .consent a {
    text-decoration: underline;
  }
  .calc-note {
    margin: -0.5rem 0 1rem;
    padding: 0.6rem 0.8rem;
    border-left: 2px solid var(--signal);
    background: rgba(255, 138, 31, 0.06);
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .err {
    min-height: 1.2em;
    margin: 0.75rem 0 0;
    color: #ff7a7a;
    font-size: var(--fs-small);
  }

  /* 리포트 */
  .report:focus {
    outline: none;
  }
  .r-head {
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .r-no {
    margin: 0;
    font-size: var(--fs-label);
    color: var(--signal);
  }
  .r-head h3 {
    margin: 0.3rem 0 0.2rem;
    font-size: 1.75rem;
  }
  .r-company {
    margin: 0;
    color: var(--muted);
  }
  .r-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 700px) {
    .r-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  h4 {
    margin: 0 0 0.6rem;
    font-size: var(--fs-label);
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .r-list {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }
  .reasons li::before {
    content: '▸ ';
    color: var(--signal);
  }
  .r-rec {
    padding: 1rem;
    border: 1px solid rgba(255, 138, 31, 0.45);
    border-radius: 8px;
    background: rgba(255, 138, 31, 0.05);
  }
  .r-product {
    margin: 0;
    font-size: 1.5rem;
    font-weight: var(--weight-strong);
    color: var(--signal);
  }
  .r-next {
    margin: 0.3rem 0 0;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .r-inc {
    margin: 0.75rem 0 0;
    padding-left: 1.1rem;
    font-size: var(--fs-small);
  }
  .r-meters {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }
  .r-meters div {
    display: flex;
    justify-content: space-between;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
  }
  .r-meters dt {
    color: var(--muted);
    font-family: var(--font-sans);
  }
  .r-meters dd {
    margin: 0;
    font-weight: 700;
  }
  .r-calc {
    margin: 0.75rem 0 0;
    padding: 0.6rem 0.8rem;
    border-left: 2px solid var(--ok);
    font-size: var(--fs-small);
  }
  .r-fine {
    margin: 0.6rem 0 0;
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .r-nextstep {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .r-nextstep ol {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }
</style>

<script>
  import { questions, type Answers, type Recommendation } from '../../data/diagnosis-rules';
  import { productById, buildLabel, won } from '../../data/products';
  import { scrollToTarget } from '../../scripts/smooth';

  const root = document.querySelector<HTMLElement>('[data-diag]')!;
  const screens = questions.map((q) => root.querySelector<HTMLFieldSetElement>(`[data-q="${q.id}"]`)!);
  const contact = root.querySelector<HTMLFormElement>('[data-contact]')!;
  const report = root.querySelector<HTMLElement>('[data-report]')!;
  const back = root.querySelector<HTMLButtonElement>('[data-back]')!;
  const stepEl = root.querySelector<HTMLElement>('[data-step]')!;
  const gauge = root.querySelector<SVGCircleElement>('[data-gauge]')!;
  const needle = root.querySelector<SVGLineElement>('[data-needle]')!;
  const err = root.querySelector<HTMLElement>('[data-err]')!;
  const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;
  const $ = (k: string) => root.querySelector<HTMLElement>(`[data-r-${k}]`)!;

  const TOTAL = questions.length;
  const answers: Answers = {};
  let idx = 0;
  let calc: Record<string, unknown> | null = null;

  function show(i: number): void {
    idx = i;
    screens.forEach((s, j) => (s.hidden = j !== i));
    contact.hidden = i !== TOTAL;
    report.hidden = i !== TOTAL + 1;
    back.hidden = i === 0 || i > TOTAL;
    const done = Math.min(i, TOTAL);
    const pct = (done / TOTAL) * 100;
    gauge.style.strokeDasharray = `${pct} 100`;
    needle.style.transform = `rotate(${90 + pct * 3.6}deg)`;
    stepEl.textContent = i < TOTAL ? `${String(i + 1).padStart(2, '0')} / ${TOTAL}` : i === TOTAL ? '연락처' : '진단 완료';
  }

  // 문항 선택
  screens.forEach((fs, i) => {
    const q = questions[i];
    const opts = Array.from(fs.querySelectorAll<HTMLButtonElement>('.opt'));
    const next = fs.querySelector<HTMLButtonElement>('[data-next]');
    opts.forEach((b) =>
      b.addEventListener('click', () => {
        if (q.multi) {
          b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
          const picked = opts.filter((o) => o.getAttribute('aria-pressed') === 'true').map((o) => o.dataset.v!);
          answers[q.id] = picked;
          next!.disabled = picked.length === 0;
        } else {
          opts.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
          answers[q.id] = b.dataset.v!;
          setTimeout(() => show(i + 1), 220);
        }
      }),
    );
    next?.addEventListener('click', () => show(i + 1));
  });
  back.addEventListener('click', () => show(Math.max(0, idx - 1)));

  // 08 계산기 값 받기
  function applyCalc(c: Record<string, unknown> | null): void {
    calc = c;
    const note = root.querySelector<HTMLElement>('[data-calc-note]')!;
    if (!c || typeof c.manual !== 'number') return;
    note.hidden = false;
    note.textContent = `계산기 값이 함께 전달됩니다 — 월 수작업 비용 ${Math.round(c.manual as number).toLocaleString('ko-KR')}원 · 비교 상품 ${c.productName}`;
  }
  try {
    applyCalc(JSON.parse(sessionStorage.getItem('knob:calc') || 'null'));
  } catch {
    /* 무시 */
  }
  window.addEventListener('knob:calc', (e) => applyCalc((e as CustomEvent).detail));

  function utm(): Record<string, string> {
    try {
      return JSON.parse(sessionStorage.getItem('knob:utm') || '{}');
    } catch {
      return {};
    }
  }

  function li(parent: HTMLElement, items: string[]): void {
    parent.replaceChildren(
      ...items.map((t) => {
        const el = document.createElement('li');
        el.textContent = t;
        return el;
      }),
    );
  }

  function renderReport(no: string, company: string, rec: Recommendation): void {
    const p = productById(rec.primary);
    $('no').textContent = `진단번호 ${no}`;
    $('company').textContent = `${company} 귀중`;
    li($('summary'), rec.summary);
    li($('reasons'), rec.reasons);
    $('product').textContent = p.name;
    li($('inc'), p.includes);
    const nextEl = $('next');
    if (rec.next) {
      nextEl.hidden = false;
      nextEl.textContent = `예산 기준 1단계 구성입니다. 2단계로 ${productById(rec.next).name}까지 확장을 권합니다.`;
    }
    $('cost').textContent = rec.estimate.max > rec.estimate.min ? `${won(rec.estimate.min)} ~ ${won(rec.estimate.max)}` : buildLabel(p);
    $('monthly').textContent = won(rec.estimate.monthly);
    $('period').textContent = rec.estimate.period;
    if (calc && typeof calc.manual === 'number') {
      const c = $('calc');
      c.hidden = false;
      c.textContent = `계산기 기준 월 수작업 비용 ${Math.round(calc.manual as number).toLocaleString('ko-KR')}원${
        typeof calc.payback === 'number' ? ` · ${calc.productName} 기준 제작비 회수 약 ${calc.payback}개월` : ''
      }`;
    }
  }

  // 전화번호: 숫자만 남겨 010-0000-0000 형태로
  const phoneInput = contact.querySelector<HTMLInputElement>('[name=phone]')!;
  phoneInput.addEventListener('input', () => {
    const d = phoneInput.value.replace(/\D/g, '').slice(0, 11);
    phoneInput.value = d.length > 7 ? `${d.slice(0, 3)}-${d.slice(3, d.length - 4)}-${d.slice(-4)}` : d.length > 3 ? `${d.slice(0, 3)}-${d.slice(3)}` : d;
  });

  contact.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.textContent = '';
    const f = new FormData(contact);
    const name = String(f.get('name') || '').trim();
    const phone = String(f.get('phone') || '').replace(/\D/g, '');
    const company = String(f.get('company') || '').trim();
    const consent = f.get('consent') === 'on';
    const bad: string[] = [];
    contact.querySelectorAll('input').forEach((i) => i.removeAttribute('aria-invalid'));
    if (!name) bad.push('name');
    if (!/^0\d{8,10}$/.test(phone)) bad.push('phone');
    if (!company) bad.push('company');
    bad.forEach((n) => contact.querySelector(`[name=${n}]`)!.setAttribute('aria-invalid', 'true'));
    if (bad.length) {
      err.textContent = bad.includes('phone') ? '연락처를 다시 확인해 주세요. (예: 010-1234-5678)' : '이름과 회사명을 입력해 주세요.';
      return;
    }
    if (!consent) {
      err.textContent = '개인정보 수집·이용에 동의하셔야 진단 결과를 받을 수 있습니다.';
      return;
    }

    submit.disabled = true;
    submit.textContent = '리포트 만드는 중…';
    try {
      const res = await fetch('/api/diagnosis', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ answers, name, phone, company, consent, website: f.get('website'), utm: utm(), calc }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) throw new Error(data.error || '전송에 실패했습니다.');
      renderReport(data.diagnosisNo, company, data.recommendation);
      show(TOTAL + 1);
      scrollToTarget('#diagnosis');
      report.focus({ preventScroll: true });
      try {
        sessionStorage.removeItem('knob:calc');
      } catch {
        /* 무시 */
      }
    } catch (x) {
      err.textContent = `${x instanceof TypeError ? '연결에 실패했습니다.' : (x as Error).message} 잠시 후 다시 시도해 주세요.`;
      submit.disabled = false;
      submit.textContent = '진단 결과 보기';
    }
  });

  show(0);
</script>
