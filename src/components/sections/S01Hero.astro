---
// 01 히어로 컨트롤 — 노브를 돌리면 가상 사무실이 수작업 혼돈 → 자동 운영으로 바뀐다.
const TICKS = 24;
const ticks = Array.from({ length: TICKS }, (_, i) => -135 + (270 / (TICKS - 1)) * i);

const bubbles = [
  '대표님 견적 문의 드려요',
  '어제 연락 준다고 하셨는데요?',
  '[광고] 신규 문의 1건',
  '담당자 누구세요?',
  '이거 누가 받았어요?',
  '부재중 전화 3통',
  '월말 정산표 어디 있어요',
  '문의 다시 남깁니다',
];
const sheets = ['문의정리_최종.xlsx', '문의정리_최종_진짜.xlsx', '9월정산_수정3.xlsx'];
const leads = [
  { name: '김OO', kind: '정책자금' },
  { name: '이OO', kind: '보험' },
  { name: '박OO', kind: '교육' },
  { name: '최OO', kind: '정책자금' },
  { name: '정OO', kind: '인테리어' },
  { name: '한OO', kind: '보험' },
];
---

<section id="hero" class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-static"></div>
    <canvas class="hero-canvas" data-hero-canvas></canvas>
  </div>

  <div class="container hero-grid">
    <div class="copy">
      <p class="label">AI 운영 시스템 · 노브</p>
      <h1 id="hero-title" data-split>돌리면,<br />돌아갑니다.</h1>
      <p class="sub">문의 정리, 담당자 배정, 정산까지.<br />사람 한 명 더 뽑기 전에 먼저 돌려보세요.</p>
      <p class="hint mono" data-hint><span class="dot"></span>노브를 돌려보세요</p>
      <a href="#diagnosis" class="hero-cta" data-scroll-link data-hero-cta>내 회사에도 돌려보기 <span aria-hidden="true">→</span></a>
    </div>

    <!-- 데스크톱: 원형 노브 -->
    <div class="knob-wrap" data-knob-wrap>
      <svg class="ticks" viewBox="0 0 360 360" aria-hidden="true">
        {ticks.map((deg) => (
          <line class="tick" x1="180" y1="14" x2="180" y2="32" transform={`rotate(${deg} 180 180)`} />
        ))}
      </svg>
      <div class="ring" data-knob-ring aria-hidden="true"></div>
      <div
        class="knob"
        role="slider"
        tabindex="0"
        aria-label="자동화 노브: 0은 수작업, 100은 자동 운영"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-knob
      >
        <div class="rotor" data-knob-rotor>
          <span class="indicator"></span>
        </div>
      </div>
      <div class="readout mono" aria-hidden="true">
        <span class="readout-label">AUTO</span>
        <span class="readout-value" data-knob-value>000</span>
      </div>
    </div>

    <!-- 모바일: 엄지로 미는 반원 슬라이더 -->
    <div class="arc-wrap" data-arc-wrap>
      <svg
        class="arc"
        viewBox="0 0 300 170"
        role="slider"
        tabindex="0"
        aria-label="자동화 노브: 0은 수작업, 100은 자동 운영"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-arc
      >
        <path class="arc-track" d="M20 150 A130 130 0 0 1 280 150" pathLength="100" />
        <path class="arc-fill" d="M20 150 A130 130 0 0 1 280 150" pathLength="100" data-arc-fill />
        <circle class="arc-thumb" r="14" cx="20" cy="150" data-arc-thumb />
        <text class="arc-value" x="150" y="128" text-anchor="middle" data-arc-value>000</text>
        <text class="arc-label" x="150" y="152" text-anchor="middle">AUTO</text>
      </svg>
    </div>

    <!-- 노브 값에 따라 바뀌는 가상 사무실 -->
    <div class="office" data-office style="--chaos:1;--order:0;--calm:0;--shake:1">
      <div class="office-bar">
        <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mono office-title">가상 사무실</span>
        <span class="tag-example">예시 화면</span>
        <span class="mono office-state" data-office-state>수작업</span>
      </div>

      <div class="office-body" aria-live="polite">
        <!-- 0~30: 혼돈 -->
        <div class="layer chaos" aria-hidden="true">
          {sheets.map((s, i) => (
            <div class="sheet" style={`--i:${i}`}>
              <span class="mono">{s}</span>
              <div class="cells">{Array.from({ length: 18 }, () => <i />)}</div>
            </div>
          ))}
          {bubbles.map((b, i) => (
            <p class="bubble" style={`--i:${i};--alt:${i % 2};--tilt:${(i % 3) - 1}`} data-bubble>
              <b>카톡</b>{b}
            </p>
          ))}
          <div class="missed mono">놓친 전화 <strong data-missed>0</strong></div>
        </div>

        <!-- 30~70: 정렬 -->
        <div class="layer kanban" aria-hidden="true">
          <div class="cols">
            <span class="mono">신규</span><span class="mono">배정</span><span class="mono">완료</span>
          </div>
          <div class="lane">
            {leads.map((l, i) => (
              <div class="kcard" data-kcard style={`--row:${i}`}>
                <span>{l.name}</span><span class="mono">{l.kind}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- 70~100: 자동 운영 -->
        <div class="layer dash">
          <div class="stats">
            <div><span class="mono stat-label">오늘 신규 문의</span><strong class="mono" data-dash="12">0</strong></div>
            <div><span class="mono stat-label">배정 완료</span><strong class="mono ok" data-dash="12">0</strong></div>
            <div><span class="mono stat-label">놓친 문의</span><strong class="mono" data-dash="0">0</strong></div>
          </div>
          <p class="notify mono"><span class="pulse"></span>09:14 [신규문의] 김OO / 정책자금 → 이선임 배정 · 고객 안내 문자 발송</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: calc(var(--header-h) + 2.5rem) 4rem;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero-bg-static,
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* 셰이더를 못 쓰는 환경의 정지 배경 */
  .hero-bg-static {
    background:
      radial-gradient(60% 50% at 75% 30%, rgba(255, 255, 255, 0.06), transparent 70%),
      radial-gradient(40% 40% at 20% 80%, rgba(255, 138, 31, 0.05), transparent 70%);
  }
  .hero-canvas {
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }
  .hero-canvas.is-on {
    opacity: 1;
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem 4rem;
    }
    .office {
      grid-column: 1 / -1;
    }
  }

  h1 {
    margin: 0.75rem 0 1.25rem;
    font-size: var(--fs-hero);
    font-weight: var(--weight-strong);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  :global(.motion-ok) [data-split] {
    visibility: hidden;
  }
  .sub {
    margin: 0;
    max-width: 32rem;
    color: var(--muted);
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
  }
  .hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 2rem 0 0;
    color: var(--muted);
    font-size: var(--fs-label);
  }
  .hint .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    animation: blink 1.6s var(--ease) infinite;
  }
  @keyframes blink {
    50% { opacity: 0.2; }
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    background: var(--signal);
    color: #111;
    font-weight: 700;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity var(--dur-scene) var(--ease),
      transform var(--dur-scene) var(--ease),
      visibility 0s linear var(--dur-scene);
  }
  .hero-cta.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  /* ── 노브 ── */
  .knob-wrap {
    position: relative;
    width: min(360px, 100%);
    aspect-ratio: 1;
    justify-self: center;
    display: grid;
    place-items: center;
  }
  .ticks {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .tick {
    stroke: var(--line);
    stroke-width: 3;
    stroke-linecap: round;
    transition: stroke var(--dur-fast) var(--ease);
  }
  :global(.motion-ok) .tick {
    opacity: 0;
  }
  .tick.is-active {
    stroke: var(--signal);
  }
  .knob {
    position: relative;
    width: 72%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #0f1013;
    box-shadow:
      0 30px 60px -20px rgba(0, 0, 0, 0.8),
      0 0 0 1px var(--line),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    touch-action: none;
  }
  @media (pointer: fine) {
    .knob,
    .knob :global(*) {
      cursor: var(--cursor-scope);
    }
  }
  .rotor {
    position: absolute;
    inset: 7%;
    border-radius: 50%;
    /* 금속 헤어라인 질감 */
    background:
      radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.14), transparent 60%),
      repeating-conic-gradient(from 0deg, #2a2d33 0deg 2deg, #24272c 2deg 4deg),
      conic-gradient(from 200deg, #3a3e45, #1c1e22, #34383e, #1a1c20, #3a3e45);
    background-blend-mode: screen, normal, normal;
    box-shadow:
      inset 0 2px 1px rgba(255, 255, 255, 0.12),
      inset 0 -6px 12px rgba(0, 0, 0, 0.5),
      0 8px 20px rgba(0, 0, 0, 0.6);
    transform: rotate(-135deg);
  }
  .indicator {
    position: absolute;
    top: 8%;
    left: 50%;
    width: 4px;
    height: 16%;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--signal);
    box-shadow: 0 0 12px rgba(255, 138, 31, 0.7);
  }
  .ring {
    position: absolute;
    width: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--signal), 0 0 40px 6px rgba(255, 138, 31, 0.45);
    opacity: 0;
    pointer-events: none;
  }
  .readout {
    position: absolute;
    bottom: -0.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
  }
  .readout-label {
    color: var(--muted);
    font-size: var(--fs-label);
  }
  .readout-value {
    font-size: 1.25rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--signal);
  }

  /* ── 모바일 반원 슬라이더 ── */
  .arc-wrap {
    display: none;
  }
  .arc {
    width: 100%;
    max-width: 340px;
    margin-inline: auto;
    touch-action: none;
    overflow: visible;
  }
  .arc-track,
  .arc-fill {
    fill: none;
    stroke-width: 14;
    stroke-linecap: round;
  }
  .arc-track {
    stroke: var(--line);
  }
  .arc-fill {
    stroke: var(--signal);
    stroke-dasharray: 0 100;
  }
  .arc-thumb {
    fill: #e8e8e8;
    stroke: var(--bg);
    stroke-width: 4;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.6));
  }
  .arc-value {
    fill: var(--signal);
    font: 700 34px var(--font-mono);
  }
  .arc-label {
    fill: var(--muted);
    font: 12px var(--font-mono);
    letter-spacing: 0.1em;
  }
  @media (max-width: 767.98px) {
    .knob-wrap {
      display: none;
    }
    .arc-wrap {
      display: block;
    }
    .hint {
      margin-top: 1.25rem;
    }
  }

  /* ── 가상 사무실 ── */
  .office {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(21, 23, 27, 0.85);
    overflow: hidden;
  }
  .office-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-label);
  }
  .lights {
    display: flex;
    gap: 5px;
  }
  .lights i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line);
  }
  .office-title {
    color: var(--muted);
  }
  .office-state {
    margin-left: auto;
    color: var(--signal);
  }
  .office-body {
    position: relative;
    height: 300px;
  }
  .layer {
    position: absolute;
    inset: 0;
    padding: 1rem;
  }

  .chaos {
    opacity: var(--chaos);
    visibility: visible;
  }
  :global(.motion-ok) .chaos {
    animation: shake 0.28s linear infinite;
  }
  @keyframes shake {
    25% { transform: translate(calc(var(--shake) * 1.5px), calc(var(--shake) * -1px)); }
    50% { transform: translate(calc(var(--shake) * -1px), calc(var(--shake) * 1.5px)); }
    75% { transform: translate(calc(var(--shake) * 1px), calc(var(--shake) * 1px)); }
  }
  .sheet {
    position: absolute;
    top: calc(12% + var(--i) * 34px);
    left: calc(6% + var(--i) * 9%);
    width: min(62%, 340px);
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #101215;
    font-size: 0.6875rem;
    color: var(--muted);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5);
  }
  .cells {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 3px;
    margin-top: 0.4rem;
  }
  .cells i {
    height: 12px;
    background: #1b1e23;
  }
  .bubble {
    position: absolute;
    right: calc(4% + var(--alt) * 14%);
    top: calc(6% + var(--i) * 10.5%);
    margin: 0;
    max-width: 60%;
    padding: 0.35rem 0.7rem;
    border-radius: 12px 12px 12px 3px;
    background: #fee500;
    color: #191919;
    font-size: 0.75rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .bubble b {
    margin-right: 0.4rem;
    font-size: 0.625rem;
  }
  .bubble.is-on {
    opacity: 1;
    transform: rotate(calc(var(--tilt) * 2deg));
  }
  .missed {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid rgba(255, 138, 31, 0.5);
    border-radius: 6px;
    background: rgba(255, 138, 31, 0.1);
    color: var(--signal);
    font-size: var(--fs-label);
  }

  .kanban {
    opacity: var(--order);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .cols span {
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
  }
  .lane {
    position: relative;
  }
  .kcard {
    --col: 0;
    position: absolute;
    left: 0;
    top: 0;
    width: calc((100% - 1.5rem) / 3);
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #101215;
    font-size: 0.8125rem;
    transform: translate(calc(var(--col) * (100% + 0.75rem)), calc(var(--row) * 40px));
    transition: transform var(--dur-scene) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .kcard .mono {
    color: var(--muted);
    font-size: 0.6875rem;
  }
  .kcard.is-done {
    border-color: rgba(61, 220, 151, 0.45);
  }

  .dash {
    opacity: var(--calm);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .stats div {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #101215;
  }
  .stat-label {
    display: block;
    color: var(--muted);
    font-size: 0.6875rem;
  }
  .stats strong {
    display: block;
    margin-top: 0.3rem;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .stats .ok {
    color: var(--ok);
  }
  .notify {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--muted);
    font-size: 0.75rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pulse {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
  }

  @media (max-width: 767.98px) {
    .office-body {
      height: 280px;
    }
    .layer {
      padding: 0.75rem;
    }
    .stats div {
      padding: 0.7rem;
    }
    .kcard {
      font-size: 0.6875rem;
      padding: 0.35rem 0.4rem;
    }
    .kcard .mono {
      display: none;
    }
  }
</style>

<script>
  import { initHero } from '../../scripts/hero';
  initHero();
</script>
