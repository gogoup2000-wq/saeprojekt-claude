---
// 10 비교표 — 사람 채용 / 홈페이지만 / 노브. 문구는 src/data/compare.ts
import SectionHead from '../SectionHead.astro';
import { compareCols, compareRows, type Mark } from '../../data/compare';

const cols = ['hire', 'site', 'knob'] as const;
const markLabel: Record<Mark, string> = { yes: '됨', part: '일부', no: '안 됨' };
---

<section id="compare" class="section compare" aria-labelledby="compare-title">
  <div class="container">
    <SectionHead
      id="compare"
      label="10 / 비교"
      title="사람을 더 뽑을까, 홈페이지를 새로 할까"
      lead="둘 다 필요할 때가 있습니다. 다만 문의가 새는 구간은 대부분 그 사이, 사람과 화면을 잇는 부분에 있습니다."
    />

    <div class="wrap card reveal">
      <table>
        <caption class="sr-only">채용, 홈페이지 제작, 노브 비교</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">항목</span></th>
            {cols.map((c) => (
              <th scope="col" class:list={['colh', { knob: c === 'knob' }]}>{compareCols[c]}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {compareRows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              {cols.map((c) => {
                const [m, text] = r[c];
                return (
                  <td class:list={[`m-${m}`, { knob: c === 'knob' }]} data-col={compareCols[c]}>
                    <span class="mark" aria-hidden="true"></span>
                    <span class="sr-only">{markLabel[m]}: </span>
                    <span class="t">{text}</span>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="fine">일반적인 경우를 비교한 표입니다. 회사마다 다를 수 있습니다.</p>
  </div>
</section>

<style>
  .wrap {
    overflow-x: auto;
    padding: 0.5rem;
  }
  table {
    width: 100%;
    min-width: 720px;
    border-collapse: separate;
    border-spacing: 0;
  }
  th,
  td {
    padding: 1rem 1.1rem;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid var(--line);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  tbody th {
    width: 22%;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  td {
    width: 26%;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  td .t {
    vertical-align: middle;
  }

  /* 노브 열: 신호색 테두리로 떠 있는 기둥 */
  .knob {
    position: relative;
    background: rgba(255, 138, 31, 0.05);
    border-left: 1px solid rgba(255, 138, 31, 0.35);
    border-right: 1px solid rgba(255, 138, 31, 0.35);
    color: var(--text);
  }
  thead .knob {
    border-top: 1px solid rgba(255, 138, 31, 0.35);
    border-radius: 10px 10px 0 0;
    color: var(--signal);
    font-weight: 700;
  }
  tbody tr:last-child .knob {
    border-bottom: 1px solid rgba(255, 138, 31, 0.35);
    border-radius: 0 0 10px 10px;
  }

  /* 표시: 됨(채운 점) / 일부(반 채운 점) / 안 됨(빈 대시) */
  .mark {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 0.6rem;
    border-radius: 50%;
    vertical-align: middle;
  }
  .m-yes .mark {
    background: var(--signal);
    box-shadow: 0 0 10px rgba(255, 138, 31, 0.6);
  }
  .m-part .mark {
    border: 1px solid #6b7079;
    background: linear-gradient(90deg, #6b7079 50%, transparent 50%);
  }
  .m-no .mark {
    width: 10px;
    height: 1px;
    border-radius: 0;
    background: #4a4f57;
  }
  /* 모바일: 표 대신 항목별 카드 — 노브 칸을 맨 위에 */
  @media (max-width: 719.98px) {
    .wrap {
      padding: 0;
      overflow: visible;
      border: 0;
      background: none;
      box-shadow: none;
    }
    table,
    tbody,
    tr,
    th,
    td {
      display: block;
      width: auto;
      min-width: 0;
    }
    thead {
      display: none;
    }
    tr {
      display: flex;
      flex-direction: column;
      margin-bottom: 0.75rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--edge), rgba(21, 23, 27, 0.82);
      overflow: hidden;
    }
    tbody th,
    td {
      width: auto;
    }
    tbody th {
      padding: 0.9rem 1rem 0.5rem;
      border: 0;
      font-size: 1rem;
    }
    td {
      display: flex;
      align-items: center;
      padding: 0.5rem 1rem;
      border: 0;
      font-size: 0.875rem;
    }
    td::before {
      content: attr(data-col);
      width: 7.5rem;
      flex-shrink: 0;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      color: #6b7079;
    }
    td.knob {
      order: -1;
      margin: 0 0.5rem 0.25rem;
      padding: 0.7rem 0.5rem;
      border: 1px solid rgba(255, 138, 31, 0.35) !important;
      border-radius: 8px !important;
    }
    td.knob::before {
      color: var(--signal);
    }
    tbody th {
      order: -2;
    }
    /* 노브 칸이 위로 올라가므로, 화면상 마지막 줄은 '홈페이지만' 칸 */
    td:nth-last-child(2) {
      padding-bottom: 0.9rem;
    }
  }
  .fine {
    margin: 1rem 0 0;
    font-size: var(--fs-small);
    color: var(--muted);
  }
</style>
