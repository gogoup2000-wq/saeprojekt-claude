---
// 16 푸터 — 사업자 정보는 src/data/company.ts 에서. 빈 값은 표시하지 않는다.
import { company } from '../../data/company';

const year = new Date().getFullYear();
const rows = [
  ['상호', company.name],
  ['대표자', company.ceo],
  ['사업자등록번호', company.bizNo],
  ['통신판매업 신고', company.mailOrderNo],
  ['주소', company.address],
  ['연락처', company.phone],
  ['이메일', company.email],
].filter(([, v]) => v);

const nav = [
  ['#industries', '업종별 시나리오'],
  ['#how', '작동 원리'],
  ['#products', '상품·가격'],
  ['#compare', '비교'],
  ['#security', '보안·운영 기준'],
  ['#faq', '자주 묻는 질문'],
];
---

<footer id="footer" class="footer">
  <div class="container">
    <div class="top">
      <div>
        <p class="logo">노브</p>
        <p class="slogan">돌리면, 돌아갑니다.<br />회사 운영 구조를 설계하는 팀.</p>
      </div>
      <nav aria-label="바닥 메뉴">
        <ul>
          {nav.map(([href, label]) => <li><a href={href} data-scroll-link>{label}</a></li>)}
        </ul>
      </nav>
    </div>
    {
      rows.length > 0 && (
        <dl class="biz">
          {rows.map(([k, v]) => (
            <div><dt>{k}</dt><dd class="mono">{v}</dd></div>
          ))}
        </dl>
      )
    }
    <p class="bottom">
      <span class="links">
        <a href="/privacy"><b>개인정보처리방침</b></a>
        <a href="#diagnosis" data-scroll-link>무료 자동화 진단</a>
      </span>
      <span class="mono">© {year} 노브</span>
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 4rem 3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--fs-small);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  .logo {
    margin: 0 0 0.5rem;
    color: var(--text);
    font-weight: var(--weight-strong);
    font-size: 1.75rem;
    letter-spacing: -0.03em;
  }
  .slogan {
    margin: 0;
    line-height: 1.7;
  }
  nav ul {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.6rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    transition: color var(--dur-fast) var(--ease);
  }
  nav a:hover {
    color: var(--text);
  }
  .biz {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
    margin: 0 0 2rem;
  }
  .biz div {
    display: flex;
    gap: 0.5rem;
  }
  dd {
    margin: 0;
    color: #b5b9c0;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .links {
    display: flex;
    gap: 1.25rem;
  }
  .links a:hover {
    color: var(--text);
  }
  .links b {
    color: var(--text);
    font-weight: 600;
  }
</style>
