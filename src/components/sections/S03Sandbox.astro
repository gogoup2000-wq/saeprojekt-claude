---
// 03 라이브 샌드박스 — 저장 없는 프론트 시뮬레이션. 방문자가 직접 문의를 보내본다.
const kinds = ['음식점', '학원', '병의원', '인테리어', '뷰티', '정책자금 컨설팅', '보험·대출', '기타'];
---

<section id="sandbox" class="sandbox" aria-labelledby="sandbox-title">
  <div class="container">
    <p class="label reveal">03 / 직접 체험</p>
    <h2 id="sandbox-title" class="reveal">문의를 하나 보내보세요</h2>
    <p class="lead reveal">고객 입장에서 문의를 넣으면, 관리화면·담당자 휴대폰·고객 문자까지 무슨 일이 일어나는지 그대로 보여드립니다.</p>

    <div class="frame">
      <p class="notice mono"><span class="dot"></span>체험용 — 입력 내용은 저장되지 않습니다</p>

      <div class="grid">
        <!-- 입력 -->
        <form class="form" data-sb-form novalidate>
          <p class="panel-title mono">고객 문의폼</p>
          <label>
            <span>이름</span>
            <input name="name" type="text" maxlength="12" placeholder="홍길동" autocomplete="off" />
          </label>
          <label>
            <span>업종</span>
            <select name="kind">
              {kinds.map((k) => <option value={k}>{k}</option>)}
            </select>
          </label>
          <label>
            <span>문의 내용</span>
            <input name="msg" type="text" maxlength="40" placeholder="견적 문의드립니다" autocomplete="off" />
          </label>
          <button type="submit" class="send" data-sb-send>문의 보내기</button>
        </form>

        <!-- 관리화면 -->
        <div class="admin">
          <p class="panel-title mono">관리화면 <span class="tag-example">예시 화면</span></p>
          <div class="board">
            <div class="col" data-col="new"><span class="col-head mono">신규 <b data-count="new">1</b></span>
              <div class="kc"><strong>최OO</strong><span class="mono">학원</span></div>
            </div>
            <div class="col" data-col="assigned"><span class="col-head mono">배정 <b data-count="assigned">1</b></span>
              <div class="kc"><strong>정OO</strong><span class="mono">음식점</span><em class="who mono">이주임</em></div>
            </div>
            <div class="col" data-col="done"><span class="col-head mono">완료 <b data-count="done">1</b></span>
              <div class="kc is-done"><strong>한OO</strong><span class="mono">뷰티</span><em class="who mono">박대리</em></div>
            </div>
          </div>
        </div>

        <!-- 휴대폰 -->
        <div class="phone">
          <div class="notch"></div>
          <p class="phone-time mono" data-sb-clock>09:00</p>
          <div class="noti" data-sb-tg>
            <span class="app mono">텔레그램 · 노브 알림봇</span>
            <p data-sb-tg-text></p>
          </div>
          <div class="noti sms" data-sb-sms>
            <span class="app mono">문자 · 고객에게 발송</span>
            <p data-sb-sms-text></p>
          </div>
          <p class="phone-empty mono" data-sb-empty>알림 대기 중</p>
        </div>
      </div>

      <!-- 처리 로그 -->
      <div class="log" role="log" aria-live="polite" data-sb-log>
        <p class="mono muted">$ tail -f knob.log</p>
      </div>
    </div>

    <p class="foot reveal">방금 보신 과정이 실제 고객사 시스템에서 사람 손 없이 일어납니다.</p>
  </div>
</section>

<style>
  .sandbox {
    padding-block: var(--section-y);
    border-top: 1px solid var(--line);
  }
  h2 {
    margin: 0.5rem 0 0.75rem;
    font-size: var(--fs-h2);
    font-weight: var(--weight-strong);
    letter-spacing: -0.02em;
  }
  .lead {
    margin: 0 0 2.5rem;
    color: var(--muted);
    max-width: 38rem;
  }
  .frame {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--edge), rgba(21, 23, 27, 0.82);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .notice {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
  }
  .grid {
    display: grid;
    gap: 1px;
    background: var(--line);
  }
  .grid > * {
    background: #121418;
    padding: 1.25rem;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: 280px 1fr 260px;
    }
  }
  .panel-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-size: var(--fs-label);
    color: var(--muted);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  input,
  select {
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }
  input:focus,
  select:focus {
    outline: none;
    border-color: var(--signal);
  }
  .send {
    margin-top: 0.4rem;
    padding: 0.8rem;
    border: 0;
    border-radius: 6px;
    background: var(--signal);
    color: #111;
    font-weight: 700;
    transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .send:hover:not(:disabled) {
    transform: translateY(-1px);
  }
  .send:disabled {
    opacity: 0.45;
    cursor: progress;
  }

  .board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-height: 200px;
    padding: 0.5rem;
    border-radius: 6px;
    background: rgba(10, 11, 13, 0.6);
  }
  .col-head {
    display: flex;
    justify-content: space-between;
    font-size: var(--fs-label);
    color: var(--muted);
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--line);
  }
  .col-head b {
    color: var(--text);
    font-weight: 400;
  }
  .board :global(.kc) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    padding: 0.5rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    font-size: 0.8125rem;
  }
  .board :global(.kc span) {
    color: var(--muted);
    font-size: 0.6875rem;
  }
  .board :global(.kc .who) {
    font-style: normal;
    font-size: 0.6875rem;
    color: var(--signal);
  }
  .board :global(.kc.is-new) {
    border-color: var(--signal);
    box-shadow: 0 0 0 3px rgba(255, 138, 31, 0.15);
    animation: pop var(--dur-scene) var(--ease);
  }
  .board :global(.kc.is-done) {
    border-color: rgba(61, 220, 151, 0.4);
  }
  @keyframes pop {
    from { opacity: 0; transform: translateY(-8px) scale(0.96); }
  }

  .phone {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 260px;
  }
  .notch {
    width: 56px;
    height: 5px;
    margin: 0 auto;
    border-radius: 3px;
    background: var(--line);
  }
  .phone-time {
    margin: 0 0 0.3rem;
    text-align: center;
    font-size: 1.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .noti {
    display: none;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(38, 42, 48, 0.55);
    backdrop-filter: blur(6px);
    animation: slide var(--dur-scene) var(--ease);
  }
  .noti:global(.is-on) {
    display: block;
  }
  .noti .app {
    font-size: 0.625rem;
    color: var(--muted);
  }
  .noti p {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    word-break: keep-all;
  }
  .sms .app {
    color: var(--ok);
  }
  @keyframes slide {
    from { opacity: 0; transform: translateY(-10px); }
  }
  .phone-empty {
    margin: auto 0;
    text-align: center;
    font-size: var(--fs-label);
    color: var(--muted);
  }

  .log {
    min-height: 132px;
    max-height: 180px;
    overflow: auto;
    padding: 0.9rem 1.1rem;
    border-top: 1px solid var(--line);
    background: #07080a;
    font-size: 0.8125rem;
  }
  .log :global(p) {
    margin: 0 0 0.2rem;
    font-family: var(--font-mono);
    white-space: pre-wrap;
    word-break: break-all;
  }
  .log :global(.muted) {
    color: var(--muted);
  }
  .log :global(.t) {
    color: var(--muted);
  }
  .log :global(.ev) {
    color: var(--signal);
  }
  .log :global(.okc) {
    color: var(--ok);
  }
  .foot {
    margin: 1.5rem 0 0;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  @media (max-width: 767.98px) {
    .grid > * {
      padding: 1rem;
    }
    .col {
      min-height: 150px;
      padding: 0.35rem;
    }
    .board :global(.kc) {
      font-size: 0.75rem;
      padding: 0.4rem;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-sb-form]')!;
  const send = document.querySelector<HTMLButtonElement>('[data-sb-send]')!;
  const log = document.querySelector<HTMLElement>('[data-sb-log]')!;
  const col = (k: string) => document.querySelector<HTMLElement>(`[data-col="${k}"]`)!;
  const count = (k: string) => document.querySelector<HTMLElement>(`[data-count="${k}"]`)!;
  const tg = document.querySelector<HTMLElement>('[data-sb-tg]')!;
  const tgText = document.querySelector<HTMLElement>('[data-sb-tg-text]')!;
  const sms = document.querySelector<HTMLElement>('[data-sb-sms]')!;
  const smsText = document.querySelector<HTMLElement>('[data-sb-sms-text]')!;
  const empty = document.querySelector<HTMLElement>('[data-sb-empty]')!;
  const clock = document.querySelector<HTMLElement>('[data-sb-clock]')!;

  const agents = ['김선임', '이주임', '박대리'];
  let turn = 0; // 라운드로빈 순서

  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const pad = (n: number) => String(n).padStart(2, '0');
  const now = () => {
    const d = new Date();
    return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
  };
  const tickClock = () => {
    const d = new Date();
    clock.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}`;
  };
  tickClock();
  setInterval(tickClock, 15000);

  function el(tag: string, cls: string, text = ''): HTMLElement {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  }
  function line(event: string, detail: string, ok = false): void {
    const p = el('p', '');
    p.append(el('span', 't', `[${now()}] `), el('span', ok ? 'okc' : 'ev', event), document.createTextNode(`  ${detail}`));
    log.append(p);
    log.scrollTop = log.scrollHeight;
  }
  function recount(): void {
    ['new', 'assigned', 'done'].forEach((k) => (count(k).textContent = String(col(k).querySelectorAll('.kc').length)));
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = (String(data.get('name') || '').trim() || '홍길동').slice(0, 12);
    const kind = String(data.get('kind'));
    const msg = (String(data.get('msg') || '').trim() || '견적 문의드립니다').slice(0, 40);
    const agent = agents[turn++ % agents.length];

    send.disabled = true;
    send.textContent = '처리 중…';
    tg.classList.remove('is-on');
    sms.classList.remove('is-on');
    empty.hidden = false;

    // (1) 관리화면 '신규'에 카드 생성
    const card = el('div', 'kc is-new');
    card.append(el('strong', '', name), el('span', 'mono', kind));
    col('new').querySelector('.col-head')!.after(card);
    recount();
    line('lead.created', `name=${name} kind=${kind} msg="${msg}"`);

    // (2) 1초 뒤 자동 배정
    await wait(1000);
    card.classList.remove('is-new');
    card.append(el('em', 'who mono', `담당자: ${agent}`));
    col('assigned').querySelector('.col-head')!.after(card);
    recount();
    line('assign.roundrobin', `→ ${agent}`);

    // (3) 담당자 휴대폰 텔레그램 알림
    tgText.textContent = `[신규문의] ${name} / ${kind}\n"${msg}" → ${agent} 배정`;
    tg.classList.add('is-on');
    empty.hidden = true;
    line('notify.telegram', `chat=${agent} delivered`);

    // (4) 3초 뒤 고객 자동 문자
    await wait(3000);
    smsText.textContent = `[노브상담] ${name}님, 문의가 접수되었습니다. 담당 ${agent}이(가) 오늘 중 연락드립니다.`;
    sms.classList.add('is-on');
    line('sms.sent', `to=${name} template=접수안내`, true);

    send.disabled = false;
    send.textContent = '한 번 더 보내기';
  });
</script>
