---
// 1단계용 자리표시 섹션. 각 단계에서 실제 섹션으로 교체된다.
interface Props {
  id: string;
  no: string;
  title: string;
  note: string;
  tall?: boolean;
}
const { id, no, title, note, tall = false } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class="container">
    <p class="label reveal">{no} / {id}</p>
    <h2 id={`${id}-title`} class="reveal">{title}</h2>
    <div class:list={['box', { tall }]}>
      <span class="mono">{note}</span>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-y);
    border-top: 1px solid var(--line);
  }
  h2 {
    margin: 0.5rem 0 2rem;
    font-size: var(--fs-h2);
    font-weight: var(--weight-strong);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .box {
    display: grid;
    place-items: center;
    min-height: 240px;
    padding: 1.5rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    background: rgba(21, 23, 27, 0.6);
    color: var(--muted);
    font-size: var(--fs-small);
    text-align: center;
  }
  .box.tall {
    min-height: 60vh;
  }
</style>
