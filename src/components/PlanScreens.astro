---
// 08 상품 — 플랜별 실제 화면(예시). 플랜마다 화면 '형태'가 다르다:
// 웹 라이트=휴대폰 2대 / 웹 프로=밝은 홈페이지+문구 수정 / 오토=연결도 / 데스크=칸반 / 풀=경영 리포트
// 880×540 고정 캔버스로 그리고, 폭에 맞춰 통째로 축소한다(스크립트는 S08Products).
// 예시 데이터: src/data/plan-screens.ts / 실제 캡처가 있으면 products.ts의 media가 우선.
import { products } from '../data/products';
import { autoPipe, board, deskKpis, fullFunnel, fullWeeks, settlement, capabilities, planCaps } from '../data/plan-screens';

const maxWeek = Math.max(...fullWeeks);
const maxLead = Math.max(...fullFunnel.map((f) => f.lead));
const totalLead = fullFunnel.reduce((a, f) => a + f.lead, 0);
const totalContract = fullFunnel.reduce((a, f) => a + f.contract, 0);
const rate = ((totalContract / totalLead) * 100).toFixed(1);
const url: Record<string, string> = {
  'web-lite': '고객 휴대폰 · 대표님 휴대폰',
  'web-pro': 'oo-math.kr',
  auto: '노브 오토 · 오늘 연결 상태',
  desk: 'admin.oo-consulting.kr / 리드 보드',
  full: 'admin.oo-consulting.kr / 9월 운영 리포트',
};
const nodeIcon = ['M', '▦', '✈', '✉', '↺'];
---

<div class="screens" data-screens>
  {products.map((p, i) => (
    <figure class="screen" data-screen={i} hidden={i !== 0} aria-label={`${p.name} 예시 화면`}>
      <!-- 이 플랜에 켜지는 기능 -->
      <ul class="caps" aria-label="포함 기능">
        {capabilities.map((c, j) => (
          <li class:list={{ on: planCaps[p.id].includes(j) }}>
            <span class="sr-only">{planCaps[p.id].includes(j) ? '포함: ' : '미포함: '}</span>{c}
          </li>
        ))}
      </ul>
      <div class="chrome">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="url mono">{url[p.id]}</span>
        <span class="tag-example">예시 화면</span>
      </div>
      <div class="viewport" data-viewport>
        <div class="canvas" data-canvas>
          {p.media.length > 0 ? (
            <img src={p.media[0]} alt={`${p.name} 실제 화면`} loading="lazy" class="shot" />
          ) : p.id === 'web-lite' ? (
            /* ── 웹 라이트: 휴대폰 2대 — 고객이 보는 홈페이지 → 대표님 휴대폰 알림 ── */
            <div class="lite">
              <div class="dev">
                <p class="dev-cap mono">고객이 보는 화면</p>
                <div class="phone light">
                  <span class="notch"></span>
                  <p class="lt-brand">OO인테리어</p>
                  <div class="lt-hero">
                    <p class="lt-h">30평대 아파트<br />전체 리모델링</p>
                    <p class="lt-s">평수·예산만 남기시면<br />실측 일정을 잡아 드립니다.</p>
                  </div>
                  <div class="lt-f"><span>이름</span><b>김OO</b></div>
                  <div class="lt-f"><span>연락처</span><b>010-····-1284</b></div>
                  <div class="lt-f two"><div><span>평수</span><b>32평</b></div><div><span>예산</span><b>3~4천만</b></div></div>
                  <span class="lt-btn">무료 상담 신청</span>
                </div>
              </div>

              <div class="flow" aria-hidden="true">
                <span class="flow-line"><i></i></span>
                <p class="mono">신청 즉시</p>
              </div>

              <div class="dev">
                <p class="dev-cap mono">대표님 휴대폰</p>
                <div class="phone dark">
                  <span class="notch"></span>
                  <p class="lock-time">9:42</p>
                  <p class="lock-date">9월 28일 월요일</p>
                  <div class="push on">
                    <p class="push-app"><span class="ic">✈</span>텔레그램 · 지금</p>
                    <p class="push-t">[새 상담 신청] 김OO</p>
                    <p class="push-b">010-····-1284 · 32평 · 3~4천만</p>
                  </div>
                  <div class="push">
                    <p class="push-app"><span class="ic">✈</span>텔레그램 · 38분 전</p>
                    <p class="push-t">[새 상담 신청] 이OO</p>
                  </div>
                </div>
              </div>
            </div>
          ) : p.id === 'web-pro' ? (
            /* ── 웹 프로: 밝은 홈페이지 — 방문자 진단 결과 + 문구 수정 창 ── */
            <div class="pro">
              <nav class="pr-nav">
                <b>OO수학</b>
                <span>반 안내</span><span>체험수업</span><span>오시는 길</span>
                <em>상담 신청</em>
              </nav>
              <div class="pr-body">
                <div class="pr-hero">
                  <p class="pr-eyebrow">초·중등 수학 전문</p>
                  <p class="pr-h">서술형까지 잡는<br />초중등 수학</p>
                  <p class="pr-s">1분 진단으로 우리 아이에게 맞는 반을 찾아 드립니다.</p>
                </div>
                <div class="pr-card">
                  <p class="pr-step">AI 상담 진단 · 완료</p>
                  <div class="pr-bar"><span></span></div>
                  <p class="pr-k">진단 결과</p>
                  <p class="pr-r">중2 서술형 집중반</p>
                  <ul>
                    <li>서술형 풀이에서 감점이 큼</li>
                    <li>개념은 잡혀 있음 → 심화 전 단계</li>
                  </ul>
                  <span class="pr-cta">토요일 10시 체험수업 신청</span>
                </div>
              </div>
              <div class="cms">
                <p class="cms-t"><span class="dot"></span>사이트 관리 · 원장님</p>
                <label><span>메인 제목</span><b>서술형까지 잡는 초중등 수학<i class="caret"></i></b></label>
                <label><span>체험수업</span><b>매주 토 10:00 · 선착순 6명</b></label>
                <span class="cms-save">저장하면 바로 반영</span>
              </div>
            </div>
          ) : p.id === 'auto' ? (
            /* ── 오토: 연결도 — 문의 한 건이 사람 손 없이 흘러가는 길 ── */
            <div class="auto">
              <p class="au-title">사람이 옮겨 적지 않습니다</p>
              <p class="au-sub">오늘 들어온 문의가 지나간 길</p>
              <div class="rail">
                <span class="wire"><i></i><i></i><i></i></span>
                {autoPipe.map((s, j) => (
                  <div class:list={['node', { last: j === autoPipe.length - 1 }]}>
                    <span class="ico">{nodeIcon[j]}</span>
                    <b>{s.step}</b>
                    <span class="cnt mono">{s.count}<small>건</small></span>
                  </div>
                ))}
              </div>
              <div class="outs">
                <div class="out">
                  <p class="o-k mono">구글시트 · 새 줄</p>
                  <p class="o-row mono"><span>09:42</span><span>김OO</span><span>···1284</span><span>메타</span></p>
                </div>
                <div class="out">
                  <p class="o-k mono">텔레그램 → 이선임</p>
                  <p>[신규문의] 김OO / 정책자금</p>
                </div>
                <div class="out">
                  <p class="o-k mono">문자 → 고객</p>
                  <p>문의가 접수되었습니다. 담당 이선임이 오늘 중 연락드립니다.</p>
                </div>
                <div class="out ok">
                  <p class="o-k mono">광고 성과 전송</p>
                  <p>계약 1건 → 메타 광고에 전달</p>
                </div>
              </div>
            </div>
          ) : p.id === 'desk' ? (
            /* ── 데스크: 칸반 — 상태 칸 사이로 고객 카드를 옮기면 배정·집계가 따라온다 ── */
            <div class="desk">
              <div class="dk-top">
                <p class="dk-title">리드 보드</p>
                <div class="dk-kpis">
                  {deskKpis.map((k) => (
                    <span><em>{k.label}</em><b class:list={{ good: k.ok }}>{k.value}</b>{k.unit}</span>
                  ))}
                </div>
              </div>
              <div class="cols4">
                {board.map((c, ci) => (
                  <div class="col">
                    <p class="col-h"><span>{c.col}</span><b class="mono">{c.cards.length}</b></p>
                    {c.cards.map((k, ki) => (
                      <div class:list={['kc', { drag: ci === 2 && ki === 1, won: c.col === '계약' }]}>
                        <p class="kc-n">{k.name}<span class="mono">{k.time}</span></p>
                        <p class="kc-t">{k.topic}</p>
                        <span class="av">{k.staff}</span>
                      </div>
                    ))}
                    {ci === 3 && <div class="drop">여기로 옮기면 정산에 자동 반영</div>}
                  </div>
                ))}
              </div>
              <p class="dk-foot mono">새 문의 → 순번대로 자동 배정(라운드로빈) · 담당자는 자기 고객만 보임</p>
            </div>
          ) : (
            /* ── 풀: 경영 리포트 — 웹 프로 + 오토 + 데스크가 합쳐진 결과 ── */
            <div class="full">
              <div class="f-head">
                <p class="f-title">9월 운영 리포트</p>
                <span class="f-layers mono">웹 프로 + 오토 + 데스크 · 매월 1일 자동 생성</span>
              </div>
              <div class="big">
                <div><em>문의</em><b>{totalLead}</b></div>
                <div><em>계약</em><b>{totalContract}</b></div>
                <div><em>계약률</em><b>{rate}<small>%</small></b></div>
                <div><em>광고로 보낸 전환</em><b class="sig">{totalContract}</b></div>
              </div>
              <div class="f-grid">
                <div class="f-card">
                  <p class="f-t">유입별 문의 → 계약</p>
                  {fullFunnel.map((f) => (
                    <div class="fr">
                      <span class="fr-n">{f.channel}</span>
                      <span class="fr-bar"><i class="l" style={`width:${(f.lead / maxLead) * 100}%`}><i class="k" style={`width:${(f.contract / f.lead) * 100}%`}></i></i></span>
                      <span class="fr-v mono">{f.lead}<b> → {f.contract}</b></span>
                    </div>
                  ))}
                </div>
                <div class="f-card">
                  <p class="f-t">주별 문의 (최근 8주)</p>
                  <div class="bars">
                    {fullWeeks.map((w, j) => (
                      <span class:list={{ last: j === fullWeeks.length - 1 }} style={`height:${(w / maxWeek) * 100}%`}></span>
                    ))}
                  </div>
                </div>
                <div class="f-card">
                  <p class="f-t">담당자별 정산</p>
                  {settlement.map((s) => (
                    <p class="st"><span>{s.staff}</span><span class="mono">{s.contract}건</span><b class="mono">{s.amount}</b></p>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    </figure>
  ))}
  <p class="swipe mono" aria-hidden="true">← 화면을 옆으로 밀어서 보세요 →</p>
  <p class="note">예시 화면입니다. 이름·연락처는 가린 형태이며, 숫자는 실제 고객사 데이터가 아닙니다.</p>
</div>

<style>
  .screen {
    margin: 0;
  }
  .screen:not([hidden]) .chrome,
  .screen:not([hidden]) .viewport {
    animation: scr-in var(--dur-scene) var(--ease);
  }
  @keyframes scr-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  /* 포함 기능 줄 */
  .caps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0 0 0.9rem;
    padding: 0;
    list-style: none;
  }
  .caps li {
    padding: 0.25rem 0.55rem;
    white-space: nowrap;
    border: 1px dashed var(--line);
    border-radius: 999px;
    color: #4f545c;
    font-size: 0.6875rem;
    transition: all var(--dur-fast) var(--ease);
  }
  .caps li.on {
    border-style: solid;
    border-color: rgba(255, 138, 31, 0.55);
    background: rgba(255, 138, 31, 0.1);
    color: var(--text);
  }
  .caps li.on::before {
    content: '●';
    margin-right: 0.35rem;
    font-size: 0.5rem;
    vertical-align: 2px;
    color: var(--signal);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-bottom-color: var(--line);
    border-radius: 14px 14px 0 0;
    background: #121418;
  }
  .dots {
    display: flex;
    gap: 5px;
  }
  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #2c3036;
  }
  .url {
    flex: 1;
    min-width: 0;
    padding: 0.2rem 0.7rem;
    border-radius: 6px;
    background: #0b0c0f;
    color: var(--muted);
    font-size: 0.6875rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* 880×540 캔버스를 폭에 맞춰 축소 */
  .viewport {
    position: relative;
    height: calc(540px * var(--s, 1));
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-top: 0;
    border-radius: 0 0 14px 14px;
    background: #0b0c0f;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.9);
  }
  /* 휴대폰: 너무 작아지지 않게 최소 배율을 두고 옆으로 밀어서 보기 */
  .viewport:global(.pan) {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }
  .viewport::before {
    content: '';
    display: block;
    width: calc(880px * var(--s, 1));
    height: 1px;
  }
  .swipe {
    display: none;
    margin: 0.5rem 0 0;
    font-size: var(--fs-label);
    color: var(--signal);
  }
  .screens:global(.can-pan) .swipe {
    display: block;
  }
  .canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 880px;
    height: 540px;
    transform: scale(var(--s, 1));
    transform-origin: 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--text);
    overflow: hidden;
  }
  .canvas p {
    margin: 0;
  }
  .shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .note {
    margin: 0.75rem 0 0;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  /* ═════ 웹 라이트: 휴대폰 2대 ═════ */
  .lite {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 36px;
    height: 100%;
    background:
      radial-gradient(50% 60% at 50% 50%, rgba(255, 138, 31, 0.1), transparent 70%),
      #0c0d10;
  }
  .dev {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .dev-cap {
    font-size: 11px;
    color: var(--muted);
  }
  .phone {
    position: relative;
    width: 232px;
    height: 460px;
    padding: 34px 16px 16px;
    border-radius: 36px;
    box-shadow: 0 0 0 7px #1d2025, 0 0 0 8px #33373e, 0 30px 60px -10px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }
  .notch {
    position: absolute;
    top: 9px;
    left: 50%;
    width: 74px;
    height: 20px;
    margin-left: -37px;
    border-radius: 12px;
    background: #000;
  }
  .phone.light {
    background: #f7f6f3;
    color: #17191d;
  }
  .lt-brand {
    font-weight: 800;
    font-size: 12px;
  }
  .lt-hero {
    margin: 14px -16px 14px;
    padding: 18px 16px;
    background: linear-gradient(135deg, #2b2621, #4a3a2a);
    color: #fff;
  }
  .lt-h {
    font-size: 21px;
    font-weight: 800;
    line-height: 1.2 !important;
    letter-spacing: -0.03em;
  }
  .lt-s {
    margin-top: 8px !important;
    font-size: 11px;
    opacity: 0.8;
  }
  .lt-f {
    display: flex;
    flex-direction: column;
    margin-bottom: 7px;
    padding: 7px 10px;
    border: 1px solid #e2dfd8;
    border-radius: 8px;
    background: #fff;
  }
  .lt-f span {
    font-size: 9.5px;
    color: #8a877f;
  }
  .lt-f b {
    font-size: 12.5px;
    font-weight: 600;
  }
  .lt-f.two {
    flex-direction: row;
    gap: 10px;
  }
  .lt-f.two div {
    display: flex;
    flex: 1;
    flex-direction: column;
  }
  .lt-btn {
    display: block;
    margin-top: 10px;
    padding: 11px;
    border-radius: 10px;
    background: var(--signal);
    color: #111;
    font-weight: 800;
    text-align: center;
  }
  .flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
  }
  .flow p {
    font-size: 11px;
    color: var(--signal);
  }
  .flow-line {
    position: relative;
    width: 110px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(255, 138, 31, 0.6), transparent);
  }
  .flow-line i {
    position: absolute;
    top: -3px;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 12px var(--signal);
  }
  .phone.dark {
    background:
      radial-gradient(120% 70% at 30% 0%, #3b2a1c, transparent 60%),
      linear-gradient(180deg, #14161a, #0b0c0f);
  }
  .lock-time {
    margin-top: 18px !important;
    text-align: center;
    font-size: 52px;
    font-weight: 300;
    letter-spacing: -0.02em;
  }
  .lock-date {
    margin-bottom: 26px !important;
    text-align: center;
    font-size: 12px;
    color: var(--text-soft);
  }
  .push {
    margin-bottom: 8px;
    padding: 10px 12px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    opacity: 0.6;
  }
  .push.on {
    opacity: 1;
    background: rgba(255, 255, 255, 0.14);
    box-shadow: 0 0 0 1px rgba(255, 138, 31, 0.55), 0 0 24px rgba(255, 138, 31, 0.25);
  }
  .push-app {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    color: var(--text-soft);
  }
  .ic {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 5px;
    background: #2aa3e6;
    color: #fff;
    font-size: 9px;
  }
  .push-t {
    margin-top: 4px !important;
    font-weight: 700;
    font-size: 12.5px;
  }
  .push-b {
    font-size: 11px;
    color: var(--text-soft);
  }

  /* ═════ 웹 프로: 밝은 홈페이지 ═════ */
  .pro {
    position: relative;
    height: 100%;
    background: #f7f6f3;
    color: #17191d;
  }
  .pr-nav {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 16px 36px;
    border-bottom: 1px solid #e6e3dc;
    background: #fff;
    font-size: 12.5px;
    color: #5b5850;
  }
  .pr-nav b {
    margin-right: 12px;
